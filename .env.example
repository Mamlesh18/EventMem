# Copy to .env and fill in. Every value is optional: with none of them set,
# EventMem runs on the hashing embedder, a mock model and an in-memory bus,
# which is enough to run the tests, the examples and the benchmarks.
#
# NEVER commit a filled-in .env. It is gitignored; .env.example is not.

# --- Azure OpenAI -----------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-chat-deployment>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment>

# --- OpenAI (alternative to Azure) ------------------------------------------
# OPENAI_API_KEY=<your-key>
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Force a specific backend (default is "auto": best available) -----------
# EVENTMEM_EMBEDDER=hashing|local|azure|openai|auto
# EVENTMEM_LLM=mock|azure|openai|auto
# EVENTMEM_TRANSPORT=memory|redis|auto
